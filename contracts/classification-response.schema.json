{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looplock.local/contracts/classification-response.schema.json",
  "title": "LoopLock classification response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "commitment_id",
    "action",
    "target_type",
    "target_value",
    "classification",
    "confidence",
    "reason_code",
    "reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid" },
    "commitment_id": { "type": "string", "format": "uuid" },
    "action": { "enum": ["TIGHTEN", "REVIEW"] },
    "target_type": { "const": "PACKAGE" },
    "target_value": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "classification": { "enum": ["DEMO_GAMBLING_APP", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason_code": {
      "enum": ["FIXTURE_MATCH", "NEEDS_REVIEW", "MODEL_UNAVAILABLE", "INVALID_MODEL_OUTPUT"]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
  }
}

