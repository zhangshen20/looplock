# Server-side Cloud Run settings only. Never place these values in the Android APK.
GOOGLE_CLOUD_PROJECT=replace-with-approved-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
LOOPLOCK_MODEL_NAME=gemini-3.5-flash
LOOPLOCK_FIRESTORE_DATABASE=(default)
LOOPLOCK_FIRESTORE_COLLECTION=classification_events
LOOPLOCK_PROCESSING_LEASE_SECONDS=60
